#!/bin/sh
# The gates come from the tree being pushed (see gates.sh); a tree with
# none pushes unchecked, as pre-commit commits unchecked.

# shellcheck source=gates.sh
. "$(dirname -- "$0")/gates.sh"
if [ ! -d "$GATES" ]; then
    echo "pre-push: skipped, no scripts/gates/ found" >&2
    exit 0
fi
updates=$(cat)

printf '%s\n' "$updates" | while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/*)
            case "$local_sha" in
                0000000000000000000000000000000000000000) continue ;;
            esac
            "$GATES/check-branch-name.sh" "${remote_ref#refs/heads/}" || exit 1
            ;;
    esac
done || exit 1

if [ -x "$GATES/check-host-tests-push.sh" ]; then
    printf '%s\n' "$updates" | "$GATES/check-host-tests-push.sh" || exit 1
fi
