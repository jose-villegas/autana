#!/bin/sh
#
# Installed by scripts/install-git-hooks.sh (which points core.hooksPath at
# this directory). Deliberately a thin dispatch: the logic for each check
# lives in its own check-*-staged.sh under scripts/gates/ so CI's shell
# linting sees it, and this file names none of them; a new one is picked
# up by the glob alone. core.hooksPath is one path shared by every worktree
# of a clone, so the gates come from the tree being committed, which may be
# on another branch than the one holding this file. A repository that uses
# this one as a submodule has no scripts/gates/ of its own and points
# core.hooksPath into the submodule, so it gets the gates beside this file.
# An unmatched glob leaves the literal pattern as $path, which fails the -x
# test below the same way a missing script does.

ROOT="$(git rev-parse --show-toplevel)"
GATES="$ROOT/scripts/gates"
[ -d "$GATES" ] || GATES="$(dirname -- "$0")/../gates"
status=0

for path in "$GATES"/check-*-staged.sh; do
	if [ ! -x "$path" ]; then
		echo "pre-commit: $(basename "$path") skipped, no scripts/gates/ found" >&2
		continue
	fi
	"$path" || status=$?
done

exit "$status"
