#!/bin/sh
#
# Proxy historical report scripts through the current board CLI.

set -eu

: "${PERF_COMPARE_AUTANA:?perf_compare.sh sets the real autana path}"
wait=${PERF_COMPARE_WAIT:-3600}
board=""
owner=""
while [ $# -gt 0 ]; do
    case "$1" in
        --wait) wait=$2; shift 2 ;;
        --board) board=$2; shift 2 ;;
        --owner) owner=$(printf '%s' "$2" | tr ' ' '-'); shift 2 ;;
        *) break ;;
    esac
done

if [ -n "$owner" ]; then set -- --owner "$owner" "$@"; fi
if [ -n "$board" ]; then set -- --board "$board" "$@"; fi
set -- --wait "$wait" "$@"
exec "$PERF_COMPARE_AUTANA" "$@"
