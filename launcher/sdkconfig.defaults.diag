# Diagnostics variant: the firmware plus the on-device test suites.
#
# Used by `tools/build/build.sh --diag` (autana's own `flash diag` and
# `selftest`), which builds it into its own directory so it never overwrites
# the normal build. Not for shipping - the suites draw to the panel and add
# test code to the image.
#
# CONFIG_LAUNCHER_SELFTEST depends on CONFIG_LAUNCHER_DEVELOPMENT (see
# Kconfig.projbuild), so this file must set both - Kconfig will not turn the
# second one on for you, and silently drops SELFTEST if it is missing.
CONFIG_LAUNCHER_SELFTEST=y
CONFIG_LAUNCHER_DEVELOPMENT=y

# No task watchdog in the diag image. The self-test runs everything in the
# main task without yielding, so IDLE starvation is expected rather than a
# fault - and the fifteenth tuning attempt proved the watchdog's only real
# effect here: its 5-second register dumps land inside benchmark timing
# windows and their console I/O gets charged to the simulation, inflating
# individual rows by up to 2.6x, silently and deterministically (the same
# image reboots to the same offsets, so repeating a capture reproduces the
# same wrong number - two budgets were once pegged from such rows). The
# release image keeps its watchdog; this is diag-only.
CONFIG_ESP_TASK_WDT_INIT=n

# The host runner's Unity supports 64-bit assertions and ESP-IDF's does not by
# default, where every one fails with "Unity 64-bit Support Disabled" - a
# portable suite must mean the same thing on both runners.
CONFIG_UNITY_ENABLE_64BIT=y

# The frame watch (profile/frame_watch.h) counts allocations made inside a frame
# through the heap's own hooks.
CONFIG_HEAP_USE_HOOKS=y

# The bootloader's own Kconfig cannot see LAUNCHER_DEVELOPMENT, so a
# development-type build turns the reset drain on here.
CONFIG_PMIC_COLD_BOOT_HOST_DRAIN=y
