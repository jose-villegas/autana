# Layered last, over sdkconfig.defaults.diag and .diag_autorun (and
# .diag_perf for the perf scope), to build an image Espressif's QEMU can run
# with no board: qemu-system-xtensa -M esp32s3. See docs/testing/QEMU.md.

# QEMU models a plain quad flash: no high-performance mode, no
# dummy-cycle-aware bootloader, no 120 MHz timing. An image built with those
# resets in the second-stage bootloader before printing anything. Nor does it
# count quad I/O's dummy cycles: in QIO mode the code still runs from the
# cache, but every esp_flash_read comes back two bytes late, so NVS never
# finds what it wrote. DIO reads correctly.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR=n
CONFIG_BOOTLOADER_FLASH_DC_AWARE=n
CONFIG_SPI_FLASH_HPM_DIS=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=n

# QEMU exposes UART0 and no USB-Serial-JTAG PHY; the secondary USB
# console's connection monitor waits for a BBPLL calibration QEMU does not
# model.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# No panel answers, so graphics presents to a null panel.
CONFIG_LAUNCHER_QEMU=y

# QEMU lacks the FPU reciprocal and reciprocal-square-root seed instructions.
CONFIG_MATH_FPU_RECIP=n
CONFIG_MATH_FPU_FUSED_MADD=n

# QEMU stops at the first PIE (EE) vector instruction.
CONFIG_SIMD_PIE=n
