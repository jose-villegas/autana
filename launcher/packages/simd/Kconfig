menu "SIMD"

    config SIMD_PIE
        bool "Use the PIE vector unit"
        depends on IDF_TARGET_ESP32S3
        default y
        help
            Run the simd calls on the ESP32-S3 PIE vector unit (128-bit
            integer lanes). Disable where the emulator lacks the EE
            instructions (Espressif QEMU); the C references run instead.

endmenu
