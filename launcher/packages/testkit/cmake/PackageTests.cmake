function(testkit_add_package_tests package)
    string(TOUPPER "${package}" prefix)
    set(package_top_level OFF)
    if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
        set(package_top_level ${PROJECT_IS_TOP_LEVEL})
    endif()
    option(${prefix}_BUILD_TESTS "Build ${package} tests" ${package_top_level})
    if(NOT ${prefix}_BUILD_TESTS)
        return()
    endif()
    if(NOT TARGET testkit_runner)
        add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../testkit" "${CMAKE_CURRENT_BINARY_DIR}/testkit")
    endif()
    file(GLOB test_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tests/*.c")
    add_executable(${package}_tests ${test_sources})
    target_link_libraries(${package}_tests PRIVATE ${package} testkit_runner)
    set_target_properties(${package}_tests PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    set(warnings -Wall -Wextra -Werror -Werror=vla -ffp-contract=off -Wno-unused-parameter)
    target_compile_options(${package}_tests PRIVATE ${warnings})
    get_target_property(package_type ${package} TYPE)
    if(NOT package_type STREQUAL "INTERFACE_LIBRARY")
        set_target_properties(${package} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        target_compile_options(${package} PRIVATE ${warnings})
    endif()
    set_target_properties(testkit testkit_runner unity PROPERTIES
                          C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    target_compile_options(testkit PRIVATE ${warnings})
    target_compile_options(testkit_runner PRIVATE ${warnings})
    add_test(NAME ${package} COMMAND ${package}_tests)
endfunction()
