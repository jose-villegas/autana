# CODE_ENTRY_OFFSET records each pad in a table the IDF linker script
# does not place; nothing reads it, flash rodata holds it.
[sections:patchable_entries]
entries:
    __patchable_function_entries

[scheme:patchable_entries_default]
entries:
    patchable_entries -> flash_rodata

[mapping:patchable_entries]
archive: libmain.a
entries:
    * (patchable_entries_default)

# Avoid cache misses in the LCD dispatch and SPI completion path used by every present.
# IRAM budget: 1574 B
[mapping:present_lcd]
archive: libesp_lcd.a
entries:
    esp_lcd_panel_ops:esp_lcd_panel_draw_bitmap (noflash)
    esp_lcd_panel_io:esp_lcd_panel_io_tx_param (noflash)
    esp_lcd_panel_io:esp_lcd_panel_io_tx_color (noflash)
    esp_lcd_panel_io_spi:panel_io_spi_tx_param (noflash)
    esp_lcd_panel_io_spi:panel_io_spi_tx_color (noflash)
    esp_lcd_panel_io_spi:lcd_spi_post_trans_color_cb (noflash)

# Avoid cache misses in the panel draw dispatch used by every present.
# IRAM budget: 327 B
[mapping:present_sh8601]
archive: libwaveshare__esp_lcd_sh8601.a
entries:
    esp_lcd_sh8601:panel_sh8601_draw_bitmap (noflash)

# RENDER_TAIL_ATTR code (render/code_layout.h) after all other flash text, so cold
# code never moves a hot flash function's cache placement. The section name does not
# start with .text, which the generic flash rule would take first; SURROUND gives the
# mapping its own line after that rule, with _render_tail_start/_end around it.
[sections:render_tail]
entries:
    .render_tail.text
    .render_tail.literal

[scheme:render_tail]
entries:
    render_tail -> flash_text

[mapping:render_tail]
archive: libmain.a
entries:
    * (render_tail);
        render_tail -> flash_text SURROUND(render_tail)
