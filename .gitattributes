# Every text file is stored and checked out with LF, on every platform.
#
# One rule for all of them, not one per extension: a file type without a rule
# keeps whatever endings the last writer used, so a tool that rewrites it
# whole turns a one-line change into a whole-file diff. eol=lf overrides each
# clone's core.autocrlf, and CRLF written by any Windows tool is normalised to
# LF when staged. Scripts need it most - bash on Linux rejects `set -eu\r` -
# and generated docs and baselines are diffed byte-for-byte in CI.
* text=auto eol=lf

*.png binary
*.otf binary
*.xcf binary
*.glb binary
*.flac binary

# Asset packs and their entries are binary.
*.bin binary
*.mesh binary

launcher/demo/*/source/** filter=lfs diff=lfs merge=lfs -text !eol
launcher/demo/*/source/**/*.mtl !filter !diff !merge text eol=lf
launcher/demo/*/source/**/*.txt !filter !diff !merge text eol=lf

# Recorded and reference audio for the microphone docs lives in LFS.
docs/audio/data/**/*.wav filter=lfs diff=lfs merge=lfs -text
docs/audio/data/**/*.flac filter=lfs diff=lfs merge=lfs -text

# Many branches append reviews; every reader takes the latest date per path,
# so ledger order does not matter.
scripts/gates/doc_review_ledger.txt merge=union
