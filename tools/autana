#!/usr/bin/env bash
#
# autana - the terminal command. scripts/autana/autana.py is all of it; this
# finds a Python to start it with, and autana.py picks ESP-IDF's own for
# anything that needs pyserial. scripts/add-tools-to-path.sh puts this folder
# on PATH.
unset _AUTANA_CALLER_PID
# Under Git Bash, /proc/<ppid>/winpid is the Windows pid of the shell that ran
# this; PPID 1 means a Windows program started bash, so autana.py finds the
# caller itself.
here=$(cd "$(dirname "$0")/.." && pwd -P)
. "$here/scripts/lib/process_pid.sh"
if [ -r "/proc/$PPID/winpid" ] || [ "$PPID" != 1 ]; then
    export _AUTANA_CALLER_PID=$(host_pid "$PPID")
fi
# shellcheck source=../scripts/lib/python.sh
. "$here/scripts/lib/python.sh"
if python=$(find_python 2>/dev/null); then
    exec "$python" "$here/scripts/autana/autana.py" "$@"
fi
# Bootstrapping must not need Python to locate ESP-IDF's Python, so this
# globs the default tools roots itself (espressif.py owns the full search).
for python in "${IDF_TOOLS_PATH:-$HOME/.espressif}"/python_env/idf*_env/Scripts/python.exe \
              /c/Espressif/*/tools/python_env/idf*_env/Scripts/python.exe; do
    python_meets_minimum "$python" && exec "$python" "$here/scripts/autana/autana.py" "$@"
done

echo "autana: no Python >= $PYTHON_MIN_VERSION found - install Python >= $PYTHON_MIN_VERSION, the py launcher or ESP-IDF; see docs/cli/README.md" >&2
exit 1
