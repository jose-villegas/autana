#!/usr/bin/env bash
#
# autana - the terminal command. scripts/autana/autana.py is all of it; this
# finds a Python to start it with, and autana.py picks ESP-IDF's own for
# anything that needs pyserial. scripts/add-tools-to-path.sh puts this folder
# on PATH.
here=$(cd "$(dirname "$0")/.." && pwd -P)
# shellcheck source=../launcher/tools/build/espressif.sh
. "$here/launcher/tools/build/espressif.sh"

# shellcheck source=../scripts/lib/python.sh
. "$here/scripts/lib/python.sh"
# find_python skips Windows' Store stub, which answers `command -v` but exits;
# ESP-IDF's own python is the fallback, and each candidate has to run.
for python in "$(find_python 2>/dev/null)" \
              "$(espressif_tools_root)"/python_env/idf*_env/Scripts/python.exe; do
    "$python" -c '' >/dev/null 2>&1 && exec "$python" "$here/scripts/autana/autana.py" "$@"
done

echo "autana: no Python found - install ESP-IDF, or see docs/tools/Autana-CLI.md" >&2
exit 1
