#!/usr/bin/env bash
#
# autana - the terminal command. scripts/autana/autana.py is all of it; this
# finds a Python to start it with. autana.py runs device.py's status and
# lock verbs in its own process and starts device.py under it for the rest;
# device.py re-runs itself under ESP-IDF's own when this one lacks pyserial.
# scripts/add-tools-to-path.sh puts this folder on PATH.
unset _AUTANA_CALLER_PID
# With the pinned minor on PATH, nothing here starts a process before the
# exec: on a loaded Windows machine each one costs a second. The checkout's
# folder comes from $0 (a Windows program may pass backslashes): entered as
# named, so a symlinked tools/ still means this checkout, then made physical
# by cd -P . and read back from $PWD, then the caller's folder again.
case "$0" in
    *[/\\]*) here=${0%[/\\]*}/.. ;;
    *) here=.. ;;
esac
caller=$PWD
CDPATH= cd "$here" && cd -P . && here=$PWD && cd "$caller" || exit 1
# Under Git Bash, /proc/<ppid>/winpid is the Windows pid of the shell that
# ran this; PPID 1 means a Windows program started bash, so autana.py finds
# the caller itself.
. "$here/scripts/lib/process_pid.sh"
if [ -r "/proc/$PPID/winpid" ] || [ "$PPID" != 1 ]; then
    host_pid "$PPID"
    export _AUTANA_CALLER_PID=$HOST_PID
fi
# shellcheck source=../scripts/lib/python.sh
. "$here/scripts/lib/python.sh"
if pinned_python; then
    exec "$PYTHON_PICKED" "$here/scripts/autana/autana.py" "$@"
fi
if python=$(find_python 2>/dev/null); then
    exec "$python" "$here/scripts/autana/autana.py" "$@"
fi
# Bootstrapping must not need Python to locate ESP-IDF's Python, so this
# globs the default tools roots itself (espressif.py owns the full search).
for python in "${IDF_TOOLS_PATH:-$HOME/.espressif}"/python_env/idf*_env/Scripts/python.exe \
              /c/Espressif/*/tools/python_env/idf*_env/Scripts/python.exe; do
    python_meets_minimum "$python" && exec "$python" "$here/scripts/autana/autana.py" "$@"
done

echo "autana: no Python >= $PYTHON_MIN_VERSION found - install Python >= $PYTHON_MIN_VERSION, the py launcher or ESP-IDF; see docs/cli/README.md" >&2
exit 1
