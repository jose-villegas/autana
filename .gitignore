### ESP-IDF
build/
# Variant build directories, e.g. build.diag from `autana flash diag`.
# Each variant keeps its own sdkconfig so it never disturbs the normal build.
build.*/
managed_components/
dependencies.lock
sdkconfig.old
/launcher/sdkconfig

# idf.py clang-check output - see launcher/.clang-tidy
warnings.txt
html_report/

# Real-hardware sweep scratch output (CSVs, raw serial captures) - see
# launcher/tools/sweeps/README.md. The scripts themselves are tracked.
launcher/tools/sweeps/results/

# Same idea for tools/report_test_results.sh - generated reports and raw
# captures, not something to commit.
launcher/tools/results/

# Same idea again for each app's own tools/ (e.g.
# launcher/main/apps/sand/tools/report_performance.sh) - an app-owned tool's
# scratch output belongs under the app, not shared tools/, so it is
# gitignored by the same pattern rather than listed per app.
launcher/main/apps/*/tools/results/

# Cppcheck writes its parse dumps NEXT TO THE SOURCE, not into its own output
# directory, so a MISRA run leaves these in main/ - see tools/misra_check.sh.
*.dump

# Captured screenshots saved here by hand - scratch output, not
# something to commit.
launcher/tools/screenshots/

### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### VS Code
# VSCode settings (keep shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# The host editor fetches its dependencies into its own build directory.
/editor/build*/
/editor/imgui.ini

### autana CLI
# Where scripts/device/device.py writes a session's log and manifest when
# AUTANA_RECORDS names nowhere else - see docs/tools/Autana-CLI.md.
.records/

### The .dev tooling checkout
# A separate repository that has to sit inside this one - see .dev/README.md.
# CLAUDE.md and AGENTS.md live in it; the two at this root are symlinks to
# them, so they belong to that repository too. Rooted, so a CLAUDE.md written
# for a subdirectory would still be tracked.
.dev/
/CLAUDE.md
/AGENTS.md

### Beads (bd issue tracker)
# Per-machine backlog database - the issues themselves travel through this
# repository's Dolt remote (refs/dolt/data), never through these files.
.beads/
.beads.gate.lock
