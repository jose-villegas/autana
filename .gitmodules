[submodule "third_party/upstream/microui"]
	path = third_party/upstream/microui
	url = https://github.com/rxi/microui.git
[submodule "third_party/upstream/small3dlib"]
	path = third_party/upstream/small3dlib
	url = https://gitlab.com/drummyfish/small3dlib.git
	# Upstream tracks both TODO.txt and todo.txt, and both
	# programs/pokitto/modelViewer.bin and modelviewer.bin. A case-insensitive
	# filesystem holds one of each pair, so the worktree reports modified the
	# moment it is cloned on Windows or macOS and no checkout can clear it.
	# Commit changes still show; only worktree dirt is ignored.
	ignore = dirty
[submodule "third_party/upstream/Waveshare-ESP32-components"]
	path = third_party/upstream/Waveshare-ESP32-components
	url = https://github.com/waveshareteam/Waveshare-ESP32-components.git
